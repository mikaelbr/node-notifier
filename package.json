{
  "name": "node-notifier",
  "version": "10.2.0",
  "description": "A Node.js module for sending notifications on native Mac, Windows (post and pre 8) and Linux (or Growl as fallback)",
  "main": "index.js",
  "scripts": {
    "pretest": "pnpm run lint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mjs",
    "example": "node ./example/message.js",
    "example:mac": "node ./example/advanced.js",
    "example:mac:input": "node ./example/macInput.js",
    "example:windows": "node ./example/toaster.js",
    "example:windows:actions": "node ./example/toaster-with-actions.js",
    "example:windows:custom-path": "cross-env DEBUG=notifier node ./example/toaster-custom-path.js",
    "copy-resources": "copyfiles -u 2 ./vendor/snoreToast/snoretoast-x64.exe ./dist/example/resources/ && copyfiles -u 1 ./example/coulson.jpg ./dist/example/resources/",
    "preexample:windows:nexe-custom-path": "rimraf dist",
    "example:windows:nexe-custom-path": "nexe -t windows-x64-14.15.3 -i ./example/toaster-custom-path.js -o ./dist/toaster-custom-path.exe && pnpm run copy-resources",
    "postexample:windows:nexe-custom-path": "cross-env DEBUG=notifier ./dist/toaster-custom-path.exe",
    "lint": "biome check",
    "prepare": "husky",
    "format": "biome check --write"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mikaelbr/node-notifier.git"
  },
  "keywords": [
    "notification center",
    "mac os x 10.8",
    "notify",
    "terminal-notifier",
    "notify-send",
    "growl",
    "windows 8 notification",
    "toaster",
    "notification"
  ],
  "author": "Mikael Brevik",
  "license": "MIT",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "copyfiles": "^2.4.1",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "nexe": "^5.0.0-beta.4",
    "rimraf": "^6.1.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "growly": "^1.3.0",
    "is-wsl": "^3.1.1"
  },
  "lint-staged": {
    "*.{js,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "bugs": {
    "url": "https://github.com/mikaelbr/node-notifier/issues"
  },
  "homepage": "https://github.com/mikaelbr/node-notifier#readme",
  "directories": {
    "example": "example",
    "test": "test"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
