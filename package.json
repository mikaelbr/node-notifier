{
  "name": "node-notifier",
  "version": "11.0.0",
  "description": "A Node.js module for sending notifications on native Mac, Windows (post and pre 8) and Linux (or Growl as fallback)",
  "keywords": [
    "notification center",
    "mac os x 10.8",
    "notify",
    "terminal-notifier",
    "notify-send",
    "growl",
    "windows 8 notification",
    "toaster",
    "notification"
  ],
  "homepage": "https://github.com/mikaelbr/node-notifier#readme",
  "bugs": {
    "url": "https://github.com/mikaelbr/node-notifier/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelbr/node-notifier.git"
  },
  "license": "MIT",
  "author": "Mikael Brevik",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./notifiers/*": "./notifiers/*.js",
    "./notifiers/*.js": "./notifiers/*.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/",
    "notifiers/",
    "vendor/"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "scripts": {
    "pretest": "pnpm run lint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.js",
    "example": "node ./example/message.js",
    "example:mac": "node ./example/advanced.js",
    "example:mac:input": "node ./example/macInput.js",
    "example:windows": "node ./example/toaster.js",
    "example:windows:actions": "node ./example/toaster-with-actions.js",
    "example:windows:custom-path": "cross-env DEBUG=notifier node ./example/toaster-custom-path.js",
    "lint": "biome check",
    "prepare": "husky",
    "format": "biome check --write"
  },
  "dependencies": {
    "growly": "^1.3.0",
    "is-wsl": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
