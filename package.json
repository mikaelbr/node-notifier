{
  "name": "node-notifier",
  "version": "12.0.0",
  "description": "A Node.js module for sending notifications on native Mac, Windows (post and pre 8) and Linux (or Growl as fallback)",
  "keywords": [
    "notification center",
    "macos",
    "notify",
    "terminal-notifier",
    "notify-send",
    "growl",
    "windows 8 notification",
    "toaster",
    "notification"
  ],
  "homepage": "https://github.com/mikaelbr/node-notifier#readme",
  "bugs": {
    "url": "https://github.com/mikaelbr/node-notifier/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikaelbr/node-notifier.git"
  },
  "license": "MIT",
  "author": "Mikael Brevik",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./notifiers/*": "./dist/notifiers/*.js",
    "./notifiers/*.js": "./dist/notifiers/*.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "vendor"
  ],
  "sideEffects": false,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc",
    "lint": "biome check",
    "format": "biome check --write",
    "prepack": "pnpm run build",
    "prepare": "husky",
    "example": "node ./example/message.ts",
    "example:mac": "node ./example/advanced.ts",
    "example:mac:input": "node ./example/macInput.ts",
    "example:linux:actions": "node ./example/notify-send-actions.ts",
    "example:windows": "node ./example/toaster.ts",
    "example:windows:actions": "node ./example/toaster-with-actions.ts",
    "example:windows:custom-path": "cross-env DEBUG=notifier node ./example/toaster-custom-path.ts"
  },
  "dependencies": {
    "growly": "^1.3.0",
    "is-wsl": "^3.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^22.20.5",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{js,ts,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
